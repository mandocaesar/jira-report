// Engineering Performance Tracker — Prisma Schema
// Phase 1: Database schema overhaul (2026-03-19)
datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// LEGACY MODELS — kept for backward compatibility, deprecated
// ============================================================

// @deprecated — Use Leave model instead
model SprintLeave {
  id         String   @id @default(cuid())
  sprintId   Int
  accountId  String
  leaveDays  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([sprintId, accountId])
  @@index([sprintId])
  @@index([accountId])
}

// @deprecated — Use CapacityAllocation model instead
model EngineerCapacity {
  id          String   @id @default(cuid())
  accountId   String
  startDate   DateTime
  endDate     DateTime
  capacity    Int      @default(100)
  reason      String   @default("other")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId])
  @@index([startDate, endDate])
}

// ============================================================
// SPRINT METRICS (existing, no changes)
// ============================================================

model SprintMetrics {
  id                  String   @id @default(cuid())
  teamId              String
  boardId             Int
  sprintId            Int
  sprintName          String
  startDate           DateTime
  endDate             DateTime
  workingDays         Int
  totalLeave          Int
  engineerCount       Int
  qaCount             Int
  engineerMandays     Int
  qaMandays           Int
  totalStoryPoints    Int
  completedPoints     Int
  averageUtilization  Float
  productPoints       Int      @default(0)
  techInitPoints      Int      @default(0)
  incidentPoints      Int      @default(0)
  forecastedCapacity  Int?
  forecastedPoints    Int?
  actualCapacity      Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([teamId, sprintId])
  @@index([teamId])
  @@index([boardId])
  @@index([sprintId])
}

// ============================================================
// ORGANISATION HIERARCHY: Group → Division → Department → Team
// ============================================================

model OrgGroup {
  id        String     @id @default(cuid())
  name      String
  code      String     @unique
  isActive  Boolean    @default(true)
  divisions Division[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Division {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  isActive    Boolean      @default(true)
  groupId     String
  group       OrgGroup     @relation(fields: [groupId], references: [id])
  departments Department[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([groupId])
}

model Department {
  id         String   @id @default(cuid())
  name       String
  code       String   @unique
  isActive   Boolean  @default(true)
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id])
  teams      Team[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([divisionId])
}

// ============================================================
// TEAM (Squad) — extended with code, isActive, data sources
// ============================================================

model Team {
  id                  String               @id @default(cuid())
  name                String
  code                String?              @unique // Squad code (e.g., "SQ-FT")
  boardId             Int                  @unique
  isActive            Boolean              @default(true)
  members             TeamMember[]
  departmentId        String?
  department          Department?          @relation(fields: [departmentId], references: [id])
  workingHoursPerDay  Float                @default(8)
  reportEmailGroup    String?
  isSchedulingEnabled Boolean              @default(false)
  dataSources         DataSource[]
  capacityAllocations CapacityAllocation[]
  nonDevDays          NonDevDay[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([departmentId])
}

// ============================================================
// TEAM MEMBER (Engineer) — extended with NIK, gender
// ============================================================

model TeamMember {
  id                  String               @id @default(cuid())
  accountId           String
  name                String
  email               String
  role                String               @default("engineer") // "engineer" or "qa"
  title               String               @default("Associate")
  nik                 String?              @unique // Employee number (unique identifier)
  gender              String?              // "male" or "female"
  workingHoursPerDay  Float?
  teamId              String
  team                Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  capacityAllocations CapacityAllocation[]
  leaves              Leave[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([teamId, accountId])
  @@index([accountId])
  @@index([nik])
}

// ============================================================
// CAPACITY ALLOCATION — per engineer/team/sprint
// ============================================================

model CapacityAllocation {
  id              String     @id @default(cuid())
  type            String     @default("SPRINT") // "SPRINT" or "BAU"
  teamMemberId    String
  teamMember      TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  teamId          String
  team            Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sprintId        Int?       // Jira sprint ID (null for BAU allocations)
  startDate       DateTime
  endDate         DateTime
  capacityPercent Int        @default(100) // 0–100
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([teamMemberId])
  @@index([teamId])
  @@index([sprintId])
  @@index([startDate, endDate])
}

// ============================================================
// NON-DEVELOPMENT DAY — days excluded from capacity in a sprint
// ============================================================

model NonDevDay {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sprintId  Int      // Jira sprint ID
  date      DateTime @db.Date
  reason    String?  // e.g., "Hackathon", "Demo Day", "Training"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, sprintId, date])
  @@index([teamId, sprintId])
}

// ============================================================
// HOLIDAY — stored in DB, replaces external API dependency
// ============================================================

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  name      String
  year      Int
  isActive  Boolean  @default(true) // Inactive holidays are not excluded from working days
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
  @@index([year])
  @@index([isActive, year])
}

// ============================================================
// DATA SOURCE — Jira board/JQL sync configuration per team
// ============================================================

model DataSource {
  id              String    @id @default(cuid())
  name            String    // Descriptive label, e.g., "Credit Card Platform"
  boardId         Int       // Jira Agile Board ID
  jqlQuery        String?   @db.Text // JQL filter for issues
  isActive        Boolean   @default(true)
  fetchWorklogs   Boolean   @default(true)
  teamId          String
  team            Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  lastSyncAt      DateTime?
  lastSyncMessage String?
  lastSyncStatus  String    @default("NEVER") // "NEVER", "HEALTHY", "ERROR", "SYNCING"
  issueCount      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([teamId])
  @@index([boardId])
}

// ============================================================
// JIRA CONNECTION — singleton config (env var replacement)
// ============================================================

model JiraConnection {
  id             String    @id @default(cuid())
  baseUrl        String    // e.g., https://your-domain.atlassian.net
  email          String    // Jira account email
  apiToken       String    // Encrypted API token
  autoSyncEnabled Boolean  @default(false)
  syncSchedule   String    @default("15min") // "15min" or "daily"
  lastTestedAt   DateTime?
  connectionStatus String  @default("NOT_CONFIGURED") // "NOT_CONFIGURED", "SAVED", "OK", "ERROR"
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ============================================================
// WORK TYPE LABEL — Jira label → category mapping
// ============================================================

model WorkTypeLabel {
  id          String   @id @default(cuid())
  labelName   String   @unique // Exact Jira label text
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// LEAVE — date-range leave with type (replaces SprintLeave)
// ============================================================

model Leave {
  id           String     @id @default(cuid())
  teamMemberId String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  startDate    DateTime   @db.Date
  endDate      DateTime   @db.Date
  type         String     @default("annual") // "annual", "sick", "personal"
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([teamMemberId])
  @@index([startDate, endDate])
}

// ============================================================
// REFERENCE DATA
// ============================================================

model TitleAvailableDays {
  id            String   @id @default(cuid())
  title         String   @unique
  availableDays Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AiSummaryCache {
  id        String   @id @default(cuid())
  type      String
  sprintId  Int      @default(0)
  boardId   Int      @default(0)
  summary   String   @db.Text
  createdAt DateTime @default(now())

  @@unique([type, sprintId, boardId], map: "type_sprintId_boardId")
  @@index([type, sprintId])
  @@index([type, boardId])
}
